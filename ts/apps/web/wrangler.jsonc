{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "worker.js",
  "name": "wondertoken-web",
  // WonderToken public application domain.
  "account_id": "386e4cf5839a99b310dc5cce80ed9700",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wondertoken-web",
    },
  ],
  "triggers": {
    "crons": ["10 0 * * *"],
  },
  "routes": [
    {
      "pattern": "token.wondercall.ai",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SOLANA_RPC_URL": "https://api.testnet.solana.com",
    "NEXT_PUBLIC_SOLANA_CLUSTER": "testnet",
    "NEXT_PUBLIC_CLUSTER": "testnet",
    "NEXT_PUBLIC_USDC_MINT": "DCM1oDQRSv9dn4xpZrXuX23yvivoFHSKKF1mjuCEcjdQ",
    "TRUST_CLOUDFLARE_HEADERS": "true",
    "NEXT_PUBLIC_SQUADS_MULTISIG_PUBKEY": "GD3jX4ixATyMN5QZGfhGZeYgz3b6bgPjSBF3qtzEfYew",
  },
  "kv_namespaces": [
    {
      "binding": "GEOBLOCKING_KV",
      "id": "ab2af7d9d20a40aea3d93673f8d01394",
      "preview_id": "5ccb6fdc64b44e399a09fd7c6e4bb93d",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUPPORT_RATE_LIMIT",
        "class_name": "SupportRateLimitDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1_support_rate_limit",
      "new_sqlite_classes": ["SupportRateLimitDurableObject"],
    },
  ],
  "d1_databases": [
    {
      "binding": "METRICS_DB",
      "database_id": "7cd90090-11c0-4d4e-aa65-8598b49049bb",
      "database_name": "wondertoken-metrics-prod",
      "migrations_dir": "../../packages/metrics-data/migrations",
    },
  ],
}
