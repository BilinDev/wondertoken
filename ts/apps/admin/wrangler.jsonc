{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "worker.js",
  "name": "wondertoken-admin",
  "account_id": "386e4cf5839a99b310dc5cce80ed9700",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wondertoken-admin",
    },
  ],
  "routes": [
    {
      "pattern": "token-admin.wondercall.ai",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SOLANA_RPC_URL": "https://api.testnet.solana.com",
    "NEXT_PUBLIC_SOLANA_CLUSTER": "testnet",
    "NEXT_PUBLIC_CLUSTER": "testnet",
    "NEXT_PUBLIC_USDC_MINT": "DCM1oDQRSv9dn4xpZrXuX23yvivoFHSKKF1mjuCEcjdQ",
    "NEXT_PUBLIC_TOKEN_METADATA_URI": "https://token.wondercall.ai/bunkercash-metadata.json",
    "NEXT_PUBLIC_SQUADS_MULTISIG_PUBKEY": "GD3jX4ixATyMN5QZGfhGZeYgz3b6bgPjSBF3qtzEfYew",
  },
  // Set ADMIN_OVERRIDE_WALLET in Cloudflare-managed worker env/secrets, not in version control.
  "kv_namespaces": [
    {
      "binding": "GEOBLOCKING_KV",
      "id": "ab2af7d9d20a40aea3d93673f8d01394",
      "preview_id": "5ccb6fdc64b44e399a09fd7c6e4bb93d",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_AUTH_NONCES",
        "class_name": "AdminAuthNonceDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1_admin_auth_nonces",
      "new_sqlite_classes": ["AdminAuthNonceDurableObject"],
    },
  ],
  "d1_databases": [
    {
      "binding": "METRICS_DB",
      "database_id": "7cd90090-11c0-4d4e-aa65-8598b49049bb",
      "database_name": "wondertoken-metrics-prod",
      "migrations_dir": "../../packages/metrics-data/migrations",
    },
  ],
}
