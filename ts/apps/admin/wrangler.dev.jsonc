    "NEXT_PUBLIC_TOKEN_METADATA_URI": "https://token.wondercall.ai/bunkercash-metadata.json",
    "NEXT_PUBLIC_SQUADS_MULTISIG_PUBKEY": "GD3jX4ixATyMN5QZGfhGZeYgz3b6bgPjSBF3qtzEfYew",
  },
  "kv_namespaces": [
    {
      "binding": "GEOBLOCKING_KV",
